{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShelfMaster",
  "version": "0.4.0",
  "identifier": "com.vibepress.shelfmaster",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3001",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ShelfMaster",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": [],
    "externalBin": [],
    "category": "Utility",
    "shortDescription": "Next-Gen Library Management System",
    "longDescription": "Lightning-fast, offline-first library operating system powered by Tauri, Rust, React and SQLite."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDQzY1NzlBMkZBM0Q4MUU5QzI0QjU2N0Q5QzNFQjRBNTZGMUU5QzI0QjU2N0Q5QzNFQjRBNTZGMUU5QzI0Qgo=",
      "endpoints": [
        "https://github.com/abusaeedsayem/VibePressStudio/releases/latest/download/latest.json",
        "https://vibepressstudio.vercel.app/api/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
