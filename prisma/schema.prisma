datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Subscriber {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  source    String   @default("footer")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id        String   @id @default(cuid())
  name      String
  email     String
  product   String   @default("vibepress-affiliate-link-cloaker")
  category  String   @default("general-inquiry")
  license   String?
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}